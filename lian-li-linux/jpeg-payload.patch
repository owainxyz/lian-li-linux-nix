From 57350de6c595fe122cf5913adccd2456e2785df9 Mon Sep 17 00:00:00 2001
From: owainxyz <281472559+owainxyz@users.noreply.github.com>
Date: Thu, 5 Nov 2026 15:54:44 +0000
Subject: [PATCH] fix(lcd): lower JPEG quality until frames fit the payload
 limit

---
 crates/lianli-media/src/common.rs   | 38 ++++++++++++++++++-----------
 crates/lianli-media/tests/common.rs | 34 ++++++++++++++++++++++++++
 2 files changed, 58 insertions(+), 14 deletions(-)

diff --git a/crates/lianli-media/src/common.rs b/crates/lianli-media/src/common.rs
index 100a3d8..6a351af 100644
--- a/crates/lianli-media/src/common.rs
+++ b/crates/lianli-media/src/common.rs
@@ -89,21 +89,31 @@ pub(crate) fn encode_compressed(
     tj_image: turbojpeg::Image<&[u8]>,
     screen: &ScreenInfo,
 ) -> Result<Vec<u8>, MediaError> {
-    let buf = if screen.png {
-        encode_png_bytes(&tj_image)?
-    } else {
-        turbojpeg::compress(
-            tj_image,
-            screen.jpeg_quality as i32,
-            turbojpeg::Subsamp::Sub2x2,
-        )
-        .map_err(|e| MediaError::ImageError(format!("turbojpeg encode: {e}")))?
-        .to_vec()
-    };
-    if buf.len() > screen.max_payload {
-        return Err(MediaError::PayloadTooLarge { size: buf.len() });
+    if screen.png {
+        let buf = encode_png_bytes(&tj_image)?;
+        if buf.len() > screen.max_payload {
+            return Err(MediaError::PayloadTooLarge { size: buf.len() });
+        }
+        return Ok(buf);
     }
-    Ok(buf)
+    let mut size = 0;
+    for quality in jpeg_qualities(screen.jpeg_quality) {
+        let buf = turbojpeg::compress(tj_image, quality as i32, turbojpeg::Subsamp::Sub2x2)
+            .map_err(|e| MediaError::ImageError(format!("turbojpeg encode: {e}")))?;
+        if buf.len() <= screen.max_payload {
+            return Ok(buf.to_vec());
+        }
+        size = buf.len();
+    }
+    Err(MediaError::PayloadTooLarge { size })
+}
+
+fn jpeg_qualities(preferred: u8) -> impl Iterator<Item = u8> {
+    std::iter::once(preferred).chain(
+        [80, 65, 50, 35, 20]
+            .into_iter()
+            .filter(move |q| *q < preferred),
+    )
 }
 
 fn encode_png_bytes(img: &turbojpeg::Image<&[u8]>) -> Result<Vec<u8>, MediaError> {
diff --git a/crates/lianli-media/tests/common.rs b/crates/lianli-media/tests/common.rs
index f0ee753..53fd85a 100644
--- a/crates/lianli-media/tests/common.rs
+++ b/crates/lianli-media/tests/common.rs
@@ -176,3 +176,37 @@ fn prepare_media_asset_color_produces_static_even_when_h264_screen() {
             .unwrap();
     assert!(matches!(asset, lianli_media::MediaAssetKind::Static { .. }));
 }
+
+fn noise_image(width: u32, height: u32) -> RgbImage {
+    let mut state = 0x2545_f491_u32;
+    ImageBuffer::from_fn(width, height, |_, _| {
+        state ^= state << 13;
+        state ^= state >> 17;
+        state ^= state << 5;
+        let [r, g, b, _] = state.to_le_bytes();
+        Rgb([r, g, b])
+    })
+}
+
+#[test]
+fn encode_jpeg_lowers_quality_to_fit_payload() {
+    let image = noise_image(480, 480);
+    let mut screen = test_screen();
+    screen.jpeg_quality = 95;
+    screen.max_payload = usize::MAX;
+    let full = encode_jpeg(image.clone(), &screen).unwrap().len();
+    screen.max_payload = full * 2 / 3;
+    let fitted = encode_jpeg(image, &screen).unwrap();
+    assert!(fitted.len() <= screen.max_payload);
+    assert_eq!(&fitted[..2], &[0xFF, 0xD8]);
+}
+
+#[test]
+fn encode_jpeg_reports_payload_too_large_below_lowest_quality() {
+    let mut screen = test_screen();
+    screen.max_payload = 1024;
+    assert!(matches!(
+        encode_jpeg(noise_image(480, 480), &screen),
+        Err(MediaError::PayloadTooLarge { .. })
+    ));
+}
